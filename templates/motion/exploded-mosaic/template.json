{
  "name": "exploded-mosaic",
  "description": "One image split into tiles separates into depth, turns, and reassembles.",
  "reference": "new",
  "rig": {
    "type": "mosaic",
    "cols": 3,
    "rows": 4,
    "depth": 1.9,
    "spread": 0.32,
    "rotSpread": 38,
    "lift": 0.32
  },
  "ranges": {
    "rig.cols": [
      2,
      4
    ],
    "rig.rows": [
      3,
      5
    ],
    "rig.depth": [
      0.8,
      3
    ]
  },
  "camera": {
    "preset": "front",
    "fit": 1.3,
    "fov": 35
  },
  "look": {
    "fog": 0.15,
    "shading": 0.35,
    "cornerRadius": 0.012
  },
  "type": {
    "roles": [
      "front"
    ],
    "maxWords": 5,
    "specimen": {
      "layer": "front",
      "zone": "bottom",
      "size": 88,
      "text": "In pieces"
    }
  },
  "cards": {
    "count": [
      1,
      1
    ],
    "aspect": [
      "4:5",
      "3:4",
      "1:1"
    ]
  },
  "beats": [
    {
      "name": "explode",
      "at": 0.08,
      "dur": 0.36,
      "to": "rig.explode",
      "from": 0,
      "value": 1,
      "ease": "motion:move",
      "why": "breaks the image apart to show what it is made of"
    },
    {
      "name": "reassemble",
      "at": 0.56,
      "dur": 0.38,
      "to": "rig.explode",
      "from": 1,
      "value": 0,
      "ease": "motion:move",
      "why": "reassembles it: the image is whole again under the line"
    },
    {
      "name": "orbit-out",
      "at": 0,
      "dur": 0.5,
      "to": "camera.orbit",
      "from": 0,
      "value": 14,
      "ease": "motion:ambient",
      "why": "connects the tiles in depth: the view turns to show the separation"
    },
    {
      "name": "orbit-back",
      "at": 0.5,
      "dur": 0.5,
      "to": "camera.orbit",
      "from": 14,
      "value": 0,
      "ease": "motion:ambient",
      "why": "connects the tiles in depth: the view turns to show the separation"
    }
  ],
  "duration": {
    "default": 8,
    "range": [
      5,
      12
    ]
  },
  "loop": true,
  "fits": [
    "one hero image",
    "a product shot",
    "a reveal of a single visual"
  ],
  "avoid": [
    "more than one card",
    "images with small text"
  ]
}
